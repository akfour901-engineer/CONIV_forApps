{
  "name": "coniv",
  "version": "0.1.0",
  "private": true,
  "description": "CONIV - The All-in-One Contracting Solution",
  "author": "CONIV Inc.",
  "main": "electron/main.js",
  "homepage": "./",
  "scripts": {
    "dev": "npm install && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "clean": "rm -rf .next node_modules",
    "build-mobile": "next build && npx cap sync android -- --clean",
    "electron": "electron .",
    "dev:desktop": "concurrently \"npm:dev\" \"wait-on http://localhost:3000 && electron .\"",
    "build-win": "next build && electron-builder --win --publish=never"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/app": "6.0.3",
    "@capacitor/core": "^6.2.1",
